{
  "name": "estudos-tdd-ts",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "main": "src/main.ts",
  "author": "@NathanRodriguesVieira99",
  "license": "MIT",
  "keywords": [],
  "engines": {
    "node": "24.16.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.cjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "git-commit-msg-linter": "^5.0.9",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
