{
  "name": "estudos-tdd-ts",
  "version": "0.2.7",
  "description": "",
  "type": "module",
  "main": "src/main.ts",
  "author": "@NathanRodriguesVieira99",
  "license": "MIT",
  "keywords": [],
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts",
    "start:dev": "tsx watch --env-file .env.dev src/main.ts",
    "start:prod": "node dist/main.cjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "lint:fix": "eslint src/*.ts --fix",
    "db:migrate": "node --env-file=.env.dev ./node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "node --env-file=.env.dev ./node_modules/knex/bin/cli.js migrate:rollback",
    "docker:up": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "prepare": "husky"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "mysql2": "^3.24.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "git-commit-msg-linter": "^5.0.9",
    "husky": "^9.1.7",
    "knex": "^3.3.0",
    "lint-staged": "^17.5.0",
    "sinon": "^22.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
