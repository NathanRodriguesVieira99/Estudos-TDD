{
  "compilerOptions": {
    "lib": ["es2024"],
    "module": "nodenext",
    "target": "es2024",
    "types": ["node", "vitest/globals"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
